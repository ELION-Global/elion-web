# ELION Environment Configuration Template
# Copy to .env.local for local development
# NEVER commit .env.local or .env.production to version control

# ─── Site ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://your-public-domain.example
NEXT_PUBLIC_SITE_NAME=ELION
# Enable only behind a verified HTTPS endpoint for the production domain.
ENABLE_HSTS=false

# ─── Analytics (optional — add when ready) ───────────────────────────────────
# NEXT_PUBLIC_ANALYTICS_ID=

# ─── Feature flags ───────────────────────────────────────────────────────────
# NEXT_PUBLIC_ENABLE_JOIN_FORM=false

# ─── API (future) ────────────────────────────────────────────────────────────
# ELION_API_URL=https://api.elion.org
# ELION_API_KEY=<secret — never expose publicly>

# ─── AWS (deployment — never in source) ──────────────────────────────────────
# AWS_REGION=us-east-1
# AWS_CLOUDFRONT_DISTRIBUTION_ID=<id>
