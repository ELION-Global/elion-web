{
  "name": "elion",
  "private": true,
  "version": "0.1.0",
  "description": "ELION — global engineering platform for peaceful technologies",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "build:static": "node scripts/build-static.mjs",
    "preview:static": "node scripts/static-preview.mjs",
    "start": "next start",
    "lint": "eslint .",
    "type-check": "tsc --noEmit --incremental false",
    "test": "node --test tests",
    "test:smoke": "node scripts/smoke-test.mjs",
    "test:static": "node scripts/build-static.mjs && node scripts/check-static-performance-budget.mjs && node scripts/smoke-static.mjs",
    "test:static:performance": "node scripts/check-static-performance-budget.mjs",
    "test:performance": "node scripts/check-performance-budget.mjs",
    "audit": "npm audit --audit-level=high"
  },
  "dependencies": {
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "22.15.29",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.1.5",
    "autoprefixer": "10.5.4",
    "eslint": "9.28.0",
    "eslint-config-next": "16.3.2",
    "postcss": "8.5.26",
    "tailwindcss": "3.4.17",
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
